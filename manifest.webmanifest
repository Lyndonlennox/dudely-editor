{
  "name": "Dudely Editor PC",
  "short_name": "Dudely Editor",
  "description": "Edit any PDF, including scans and photos, without changing its layout; convert to Word and back to PDF.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#EAF0F0",
  "theme_color": "#033438",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/png": [
          ".png"
        ]
      }
    }
  ],
  "id": "./?app=dudely-editor-pc"
}